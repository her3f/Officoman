[Desktop Entry]
Type=Application
Name=Podium
GenericName=Presentation
Comment=Create and present slide decks
Exec=podium %F
TryExec=podium
Icon=io.github.her3f.podium
Terminal=false
StartupNotify=true
StartupWMClass=io.github.her3f.podium
Categories=Office;Presentation;
MimeType=application/x-podium;application/vnd.openxmlformats-officedocument.presentationml.presentation;application/vnd.openxmlformats-officedocument.presentationml.template;application/vnd.openxmlformats-officedocument.presentationml.slideshow;
Keywords=presentation;slides;slide show;deck;pptx;keynote;powerpoint;
