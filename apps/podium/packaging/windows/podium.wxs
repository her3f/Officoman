<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <?ifndef HasCraftFontLicences ?>
  <?define HasCraftFontLicences=0 ?>
  <?endif?>
  <Package Name="Podium" Manufacturer="White Office" Version="$(var.Version)" UpgradeCode="6F9C69E7-7825-40D2-BF26-C274DA676425" Scope="perUserOrMachine" Compressed="yes" Language="1033">
    <SummaryInformation Description="Podium presentations and slide shows" Manufacturer="White Office" />
    <?include $(sys.SOURCEFILEDIR)install-policy.wxi?>
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of Podium is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="PodiumIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="PodiumIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://officoman.whitebearom.com/apps/podium.html" />
    <Property Id="ARPURLUPDATEINFO" Value="https://officoman.whitebearom.com/apps/podium.html" />
    <Property Id="ARPHELPLINK" Value="https://github.com/her3f/officoman/discussions" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="CraftSuiteFolder" Name="White Office">
        <Directory Id="INSTALLFOLDER" Name="Podium" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="Podium" Level="1">
      <?if $(var.HasCraftFontLicences) = 1 ?>
      <ComponentGroupRef Id="CraftFontLicences" />
      <?endif?>
      <ComponentGroupRef Id="PodiumFiles" />
    </Feature>
  <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" Condition="NOT Installed" />
    </UI>
  </Package>

  <Fragment>
    <?if $(var.HasCraftFontLicences) = 1 ?>
    <ComponentGroup Id="CraftFontLicences" Directory="INSTALLFOLDER">
      <Files Include="$(var.DocsDir)\**" />
    </ComponentGroup>
    <?endif?>
    <ComponentGroup Id="PodiumFiles" Directory="INSTALLFOLDER">
      <Component Id="PodiumApp" Guid="D87EA444-41A4-4C19-922E-66D1A29461FF">
        <File Id="PodiumNotice" Source="$(var.BinDir)\NOTICE" KeyPath="no" />
        <File Id="PodiumExe" Source="$(var.BinDir)\podium.exe" KeyPath="yes">
          <!-- No Icon here, so the shortcut shows the icon embedded in podium.exe (build.rs). An
               MSI Icon is cached under %APPDATA%\Microsoft\Installer\{ProductCode}\, and every
               update is a major upgrade with a new ProductCode that deletes the old folder. A
               taskbar pin is a copy of this shortcut that the update never touches, so it kept
               pointing at the deleted file and lost its icon (#1114). The exe's path survives
               updates; the shortcut is not advertised, so it targets that path and its icon is the
               exe's own. The Icon above stays for ARPPRODUCTICON (Apps and features). -->
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Podium" Description="Podium presentations and slide shows" WorkingDirectory="INSTALLFOLDER" Advertise="no" />
        </File>

        <!-- .podium: Podium's own format. -->
        <ProgId Id="Podium.Presentation" Description="Podium Presentation" Icon="PodiumExe" IconIndex="0">
          <Extension Id="podium" ContentType="application/x-podium">
            <Verb Id="open" Command="Open" TargetFile="PodiumExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>

        <!-- "Open with" for PowerPoint formats, without becoming the default. -->
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\podium.exe" Name="FriendlyAppName" Value="Podium" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\podium.exe\shell\open\command" Value="&quot;[#PodiumExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\podium.exe\SupportedTypes" Name=".podium" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\podium.exe\SupportedTypes" Name=".pptx" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\podium.exe\SupportedTypes" Name=".potx" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\podium.exe\SupportedTypes" Name=".ppsx" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.pptx\OpenWithProgids" Name="Podium.Presentation" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.potx\OpenWithProgids" Name="Podium.Presentation" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.ppsx\OpenWithProgids" Name="Podium.Presentation" Value="" Type="string" />

        <RegistryValue Root="HKMU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\podium.exe" Value="[#PodiumExe]" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Podium" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

      <Component Id="PodiumCli">
        <File Id="PodiumCliExe" Source="$(var.BinDir)\podium-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
