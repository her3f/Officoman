<?xml version="1.0" encoding="utf-8"?>
<!--
  Courier MSI (WiX Toolset v5: `dotnet tool install -g wix`, plus its UI and Util extensions:
  `wix extension add -g WixToolset.UI.wixext/5.0.2` and the same for WixToolset.Util.wixext).
  Built by package.ps1:

    wix build courier.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
      -d Version=1.2.3 -d BinDir=... -d IconPath=... -d LicenseRtf=... -o out.msi

  Per-machine install into Program Files with a Start Menu shortcut. The installer shows the
  standard WiX dialogs: welcome + license, progress, and a finish page.

  UpgradeCode and the component GUIDs below belong to Courier alone. Never copy them from (or
  into) a sibling Craft app: Windows Installer treats every package sharing an UpgradeCode as one
  product, so a shared code makes one app's installer refuse to install ("a newer version is
  already installed") or silently uninstall the other. packaging-lint.yml checks this.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="Courier"
      Manufacturer="Courier contributors"
      Version="$(var.Version)"
      UpgradeCode="647FB3CC-7876-4DC8-84D9-CE2DD295D1C7"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="Courier mail and calendar" Manufacturer="Courier contributors" />
    <!-- Any other version replaces the one installed: a newer one, the same X.Y.Z (successive
         pre-releases of one X.Y.Z replace each other; MSI versions are numeric, so 1.2.3-rc.1 and
         1.2.3-rc.2 are both 1.2.3; AllowDowngrades takes in AllowSameVersionUpgrades) and an
         older one. Downgrades are allowed so that Courier can go back to the version an update replaced, when the
         new one doesn't start (apps/courier/src/self_update.rs): installing this package over
         a newer Courier replaces it. The mailbox is in the user's own folder either way. -->
    <MajorUpgrade AllowDowngrades="yes" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="CourierIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="CourierIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/her3f/officoman" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/her3f/officoman" />
    <Property Id="ARPHELPLINK" Value="https://github.com/her3f/officoman/issues" />

    <!-- Installer UI (#198): WixUI_Minimal is welcome + license, progress, then a finish page so
         people can see the install worked. Its dialogs and bitmaps are WiX's own
         (WixToolset.UI.wixext); package.ps1 builds the license RTF from LICENSE-MIT and
         LICENSE-APACHE. The finish page offers to launch Courier (ticked by default) through
         WixShellExec (WixToolset.Util.wixext); silent installs (/qn) never show it. -->
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Courier" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#CourierExe]" />
    <CustomAction Id="LaunchCourier" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec"
        Impersonate="yes" Return="ignore" />
    <UI>
      <ui:WixUI Id="WixUI_Minimal" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchCourier"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>

    <!-- An organisation turns Courier's updating by itself off for every user of the computer
         by installing with DISABLEAUTOMATICUPDATES=1
         (`msiexec /i courier-….msi DISABLEAUTOMATICUPDATES=1`): the policy value the program
         reads (HKLM\Software\Policies\Courier, DisableAutomaticUpdates = 1) is written, and
         removed again with the program. A Group Policy can set the same value instead. -->
    <Property Id="DISABLEAUTOMATICUPDATES" Secure="yes" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Courier" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="Courier" Level="1">
      <ComponentGroupRef Id="CourierFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="CourierFiles" Directory="INSTALLFOLDER">
      <Component Id="CourierApp" Guid="6883EF8E-7160-4B89-85C5-0DB6E7264E61">
        <File Id="CourierExe" Source="$(var.BinDir)\courier.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Courier"
              Description="Courier mail and calendar" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="CourierIcon.ico" IconIndex="0">
            <!-- The AppUserModelID Windows knows Courier by: it shows the program's desktop
                 alerts (toasts) only for a program it knows by such a shortcut
                 (apps/courier/src/alerts.rs). -->
            <ShortcutProperty Key="System.AppUserModel.ID" Value="Courier.Courier" />
          </Shortcut>
        </File>

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\courier.exe" Value="[#CourierExe]" Type="string" />
      </Component>

      <!-- What Courier opens. Each file type gets a Courier ProgId (name, icon, open command)
           and is listed under the extension's OpenWithProgids, so Courier shows in Explorer's "Open
           with"; messages, calendar files and contact cards are also Courier's Capabilities
           (RegisteredApplications), as is the mailto: link type, so Courier appears in Settings ›
           Default apps, where the owner makes it the mail program. Nothing here sets a default for a
           type another program may own: the installer never takes over .eml, .ics, .vcf or mailto:.
           A mailbox file (.courier) is Courier's own and opens with it. A second start hands the
           file or link to the window that is already open (apps/courier/src/single_instance.rs).
           Removed again on uninstall. -->
      <Component Id="CourierFileTypes" Guid="D5E14B14-1BE0-4E96-A849-E5F04AC4D6BB">
        <RegistryValue Root="HKLM" Key="Software\RegisteredApplications" Name="Courier" Value="Software\Courier\Capabilities" Type="string" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="Software\Courier\Capabilities" Name="ApplicationName" Value="Courier" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Courier\Capabilities" Name="ApplicationDescription" Value="Mail, calendar, contacts and tasks; opens messages, calendar files and contact cards." Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Courier\Capabilities" Name="ApplicationIcon" Value="&quot;[#CourierExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\courier.exe" Name="FriendlyAppName" Value="Courier" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\courier.exe\shell\open\command" Value="&quot;[#CourierExe]&quot; &quot;%1&quot;" Type="string" />

        <ProgId Id="Courier.Message" Description="Email Message" Icon="CourierExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Courier.Message\shell\open\command" Value="&quot;[#CourierExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.eml\OpenWithProgids" Name="Courier.Message" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\courier.exe\SupportedTypes" Name=".eml" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Courier\Capabilities\FileAssociations" Name=".eml" Value="Courier.Message" Type="string" />

        <ProgId Id="Courier.Calendar" Description="iCalendar File" Icon="CourierExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Courier.Calendar\shell\open\command" Value="&quot;[#CourierExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.ics\OpenWithProgids" Name="Courier.Calendar" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\courier.exe\SupportedTypes" Name=".ics" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Courier\Capabilities\FileAssociations" Name=".ics" Value="Courier.Calendar" Type="string" />

        <ProgId Id="Courier.Contact" Description="vCard File" Icon="CourierExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Courier.Contact\shell\open\command" Value="&quot;[#CourierExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.vcf\OpenWithProgids" Name="Courier.Contact" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\courier.exe\SupportedTypes" Name=".vcf" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Courier\Capabilities\FileAssociations" Name=".vcf" Value="Courier.Contact" Type="string" />

        <ProgId Id="Courier.MailFolder" Description="Mail Folder File" Icon="CourierExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Courier.MailFolder\shell\open\command" Value="&quot;[#CourierExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.mbox\OpenWithProgids" Name="Courier.MailFolder" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\courier.exe\SupportedTypes" Name=".mbox" Value="" Type="string" />

        <ProgId Id="Courier.Mailbox" Description="Courier Mailbox" Icon="CourierExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Courier.Mailbox\shell\open\command" Value="&quot;[#CourierExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.courier\OpenWithProgids" Name="Courier.Mailbox" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\courier.exe\SupportedTypes" Name=".courier" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Courier\Capabilities\FileAssociations" Name=".courier" Value="Courier.Mailbox" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.courier" Value="Courier.Mailbox" Type="string" />

        <!-- mailto: links. `URL Protocol` marks the ProgId as a link handler. -->
        <ProgId Id="Courier.Url.mailto" Description="Courier Mail Link" Icon="CourierExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Courier.Url.mailto" Name="URL Protocol" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Courier.Url.mailto\shell\open\command" Value="&quot;[#CourierExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Courier\Capabilities\URLAssociations" Name="mailto" Value="Courier.Url.mailto" Type="string" />
      </Component>
      <Component Id="CourierUpdatePolicy" Guid="3B0C9E57-5A2D-4F0B-9C0E-7D8E2F61A4C3" Condition="DISABLEAUTOMATICUPDATES = 1">
        <RegistryValue Root="HKLM" Key="Software\Policies\Courier" Name="DisableAutomaticUpdates" Value="1" Type="integer" KeyPath="yes" />
      </Component>
      <Component Id="CourierCli">
        <File Id="CourierCliExe" Source="$(var.BinDir)\courier-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
